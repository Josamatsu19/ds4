@model SemestralWeb.Models.RecetaVista
@{ ViewBag.Title = "Nueva Receta Maestra"; }

<h2>🍳 Crear Nueva Receta</h2>

<form id="formReceta" method="post" action="@Url.Action("Crear", "Home")">

    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label>Nombre del Plato</label>
                <input type="text" name="Nombre" class="form-control" required placeholder="Ej: Arroz con Pollo" />
            </div>
            <div class="form-group">
                <label>Instrucciones</label>
                <textarea name="Instrucciones" class="form-control" rows="3" required placeholder="Paso 1..."></textarea>
            </div>
            <div class="form-group">
                <label>Porciones Originales</label>
                <input type="number" name="Porciones" class="form-control" required value="4" />
            </div>
        </div>
    </div>

    <hr />

    <h3>🥕 Ingredientes</h3>
    <p class="text-muted">Agrega los ingredientes uno por uno.</p>

    <table class="table table-bordered" id="tablaIngredientes">
        <thead>
            <tr>
                <th>Ingrediente (Ej: Pollo)</th>
                <th>Cantidad</th>
                <th>Unidad</th>
                <th>Acción</th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>

    <button type="button" class="btn btn-info" id="btnAgregarIngrediente">+ Agregar Ingrediente</button>

    <hr />

    <button type="submit" class="btn btn-success btn-lg">Guardar Receta Completa</button>
    <a href="@Url.Action("Index", "Home")" class="btn btn-default">Cancelar</a>
</form>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        var contador = 0;

        $("#btnAgregarIngrediente").click(function () {
            // Dropdown de unidades fijo
            var selectUnidad = `
                <select name="ListaIngredientes[${contador}].Unidad" class="form-control">
                    <option value="Unidad">Unidad (Pza)</option>
                    <option value="Gramos">Gramos (g)</option>
                    <option value="Kilogramos">Kilogramos (kg)</option>
                    <option value="Litros">Litros (L)</option>
                    <option value="Mililitros">Mililitros (ml)</option>
                    <option value="Cucharadas">Cucharadas</option>
                    <option value="Tazas">Tazas</option>
                    <option value="Libras">Libras (lb)</option>
                </select>`;

            var nuevaFila = `
                <tr>
                    <td>
                        <input type="text" name="ListaIngredientes[${contador}].Nombre" class="form-control" required placeholder="Nombre ingrediente" />
                    </td>
                    <td>
                        <input type="number" step="0.01" name="ListaIngredientes[${contador}].Cantidad" class="form-control" required placeholder="0.00" />
                    </td>
                    <td>${selectUnidad}</td>
                    <td>
                        <button type="button" class="btn btn-danger btn-xs btn-borrar">X</button>
                    </td>
                </tr>`;

            $("#tablaIngredientes tbody").append(nuevaFila);
            contador++;
        });

        // Funcionalidad para borrar fila
        $(document).on('click', '.btn-borrar', function () {
            $(this).closest('tr').remove();
        });
    });
</script>